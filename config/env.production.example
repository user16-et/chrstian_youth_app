NODE_ENV=production
HTTPS_ONLY=true
TRUST_PROXY=true
CORS_ORIGINS=https://app.example.org,https://admin.example.org
DATABASE_URL_FILE=/run/secrets/database_url
DATABASE_READ_URL_FILE=/run/secrets/database_read_url
REDIS_URL_FILE=/run/secrets/redis_url
JWT_SECRET_FILE=/run/secrets/jwt_secret
ADMIN_JWT_ISSUER=christian-super-app-api
ADMIN_JWT_AUDIENCE=christian-super-app-admin
ADMIN_JWT_TTL_SECONDS=900
MEDIA_STORAGE_PROVIDER=s3
MEDIA_BUCKET=christian-super-app-production
MEDIA_REGION=af-south-1
MEDIA_ACCESS_KEY_ID_FILE=/run/secrets/media_access_key_id
MEDIA_SECRET_ACCESS_KEY_FILE=/run/secrets/media_secret_access_key
MEDIA_PUBLIC_BASE_URL=https://media.example.org
VIRUS_SCAN_PROVIDER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
MEILI_MASTER_KEY_FILE=/run/secrets/meili_master_key
