# Worker core
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/christian_super_app
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=5

# SMS / OTP delivery
# SMS_PROVIDER=disabled keeps OTP delivery as a log line (local dev, demos).
# Set SMS_PROVIDER=afromessage in staging/production to send real SMS.
SMS_PROVIDER=disabled
SMS_APP_NAME=Christian Youth

# AfroMessage (https://afromessage.com) — required when SMS_PROVIDER=afromessage.
# AFROMESSAGE_TOKEN is the API access token (JWT) from the AfroMessage dashboard.
# AFROMESSAGE_FROM is the sender/identifier ID; AFROMESSAGE_SENDER is the approved sender name.
AFROMESSAGE_BASE_URL=https://api.afromessage.com/api
AFROMESSAGE_TOKEN=
AFROMESSAGE_FROM=
AFROMESSAGE_SENDER=
AFROMESSAGE_CALLBACK=
