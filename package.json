{
  "name": "christian-youth-super-app",
  "private": true,
  "workspaces": [
    "services/*",
    "packages/*",
    "apps/admin"
  ],
  "scripts": {
    "build:api": "npm --workspace packages/shared run build && npm --workspace services/api run build",
    "build:shared": "npm --workspace packages/shared run build",
    "build:worker": "npm --workspace packages/shared run build && npm --workspace services/worker run build",
    "lint:api": "npm --workspace services/api run lint",
    "lint:shared": "npm --workspace packages/shared run lint",
    "lint:worker": "npm --workspace services/worker run lint",
    "build:admin": "npm --workspace apps/admin run build",
    "analyze:mobile": "cd apps/mobile && /home/toor/pro/chrstian_app/.sdk/flutter/bin/flutter analyze",
    "build:web:mobile": "cd apps/mobile && /home/toor/pro/chrstian_app/.sdk/flutter/bin/flutter build web",
    "build:apk:mobile": "cd apps/mobile && /home/toor/pro/chrstian_app/.sdk/flutter/bin/flutter build apk --debug",
    "dev": "bash scripts/dev.sh",
    "test:integration": "bash scripts/integration-mobile-api.sh",
    "stop": "bash scripts/stop.sh",
    "logs": "bash scripts/logs.sh",
    "clean": "bash scripts/clean.sh",
    "demo:reset": "bash scripts/demo-reset.sh",
    "demo:smoke": "bash scripts/demo-smoke.sh",
    "verify": "bash scripts/verify.sh",
    "security:audit": "npm audit --audit-level=high",
    "security:check": "npm run lint:shared && npm run lint:api && npm run lint:worker && npm run security:audit",
    "admin:create": "npm --workspace services/api run admin:create --"
  }
}
